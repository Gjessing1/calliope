{
  "name": "@calliope/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API over the library index, and static host for the built web app.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@calliope/core": "*",
    "@calliope/epub": "*",
    "@calliope/library": "*",
    "@calliope/metadata": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.2.0"
  }
}
