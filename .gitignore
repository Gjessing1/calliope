.env
.env.*
!.env.example

# --- Persistent data (host: /mnt/data/calliope) ---
data/
# Dev symlink to the host data dir (trailing-slash patterns don't match symlinks).
backend/data
*.sqlite
*.sqlite-shm
*.sqlite-wal

# --- Android build artifacts ---
apps/android/android/
apps/android/.gradle-home/

