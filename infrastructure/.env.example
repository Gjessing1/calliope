# Copy to /home/gjessing/docker/calliope/.env and fill in.

# Audiobookshelf API key: ABS → Settings → API Keys → Add. The user it acts as
# needs admin rights only if ABS_RESCAN_ON_SAVE is left on.
ABS_TOKEN=

# Optional — restrict Calliope to one ABS library instead of every book library.
# ABS_LIBRARY_ID=

# Optional — set to false to let ABS's own filesystem watcher notice edits
# instead of being told about them.
# ABS_RESCAN_ON_SAVE=true

# Optional — ABS as a *browser* reaches it, base path included (ABS serves its
# UI under /audiobookshelf). Enables "Open in Audiobookshelf" links.
# ABS_PUBLIC_URL=https://ab.gjessing.io/audiobookshelf

# Optional — full pre-write EPUB snapshots retained per book under /data.
# CALLIOPE_REVISION_LIMIT=10
